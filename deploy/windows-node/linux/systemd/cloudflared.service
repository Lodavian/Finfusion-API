[Unit]
Description=Finfusion named Cloudflare Tunnel
After=network-online.target finfusion-vault.service
Wants=network-online.target
Requires=finfusion-vault.service

[Service]
Type=simple
User=finfusion
Group=finfusion
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:2000 run --token-file /run/finfusion/secrets/tunnel_token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/run/finfusion/secrets/tunnel_token

[Install]
WantedBy=multi-user.target
